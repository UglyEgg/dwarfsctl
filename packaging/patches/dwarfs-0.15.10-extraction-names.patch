--- a/src/utility/filesystem_extractor.cpp
+++ b/src/utility/filesystem_extractor.cpp
@@ -31,6 +31,7 @@
 #include <exception>
 #include <memory>
 #include <mutex>
+#include <stdexcept>
 #include <thread>
 #include <unordered_set>
 
@@ -434,6 +435,21 @@
     reader::filesystem_v2_lite const& fs, glob_matcher const* matcher,
     filesystem_extractor_options const& opts) {
   DWARFS_CHECK(a_, "filesystem not opened");
+
+  // Validate the actual filesystem being extracted, before any entry write or
+  // worker submission. Stored components are names, never paths; symlink
+  // targets are separate metadata and may legitimately point outside the tree.
+  fs.walk([](auto entry) {
+    if (entry.is_root()) {
+      return;
+    }
+    auto const name = entry.name();
+    if (name.empty() || name == "." || name == ".." ||
+        name.find('/') != std::string::npos ||
+        name.find('\0') != std::string::npos) {
+      throw std::invalid_argument("unsafe entry name in image");
+    }
+  });
 
   auto sparse_mode = sparse_mode_;
   bool supports_hardlinks{true};
