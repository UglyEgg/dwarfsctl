[Desktop Entry]
Type=Application
Name=Open DwarFS Image
Comment=Mount a DwarFS image and open its contents
Exec=dwarfsctl-open %f
Icon=dwarfsctl
Terminal=false
NoDisplay=true
MimeType=application/x-dwarfs;application/x-dwarfs-image;
Categories=Qt;KDE;Utility;Archiving;
InitialPreference=10
StartupNotify=true
