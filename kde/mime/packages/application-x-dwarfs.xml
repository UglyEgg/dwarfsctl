<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-dwarfs">
    <comment>DwarFS filesystem image</comment>
    <icon name="dwarfsctlimage"/>
    <generic-icon name="package-x-generic"/>
    <alias type="application/x-dwarfs-image"/>
    <glob pattern="*.dwarfs" weight="80"/>
    <magic priority="50">
      <match type="string" offset="0" value="DWARFS"/>
    </magic>
  </mime-type>
</mime-info>
